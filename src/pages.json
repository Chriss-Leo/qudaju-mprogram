    {
      "path": "pages/profile/index",
      "style": { "navigationStyle": "custom", "navigationBarTitleText": "个人中心" }
    },
    {
      "path": "pages/provider/index",
      "style": { "navigationStyle": "custom", "navigationBarTitleText": "服务者中心" }
